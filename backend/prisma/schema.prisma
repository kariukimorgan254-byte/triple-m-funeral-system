generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum CasketMaterial {
  SOLID_WOOD
  VENEER
  METAL_STEEL
  METAL_COPPER
  METAL_BRONZE
  FIBERGLASS
  BIODEGRADABLE
}

enum CasketSize {
  CHILD
  STANDARD
  OVERSIZED
  BARIATRIC
}

enum InventoryStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
}

enum HearseStatus {
  AVAILABLE
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  INQUIRY
  TENTATIVE
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum ServiceType {
  TRADITIONAL_FUNERAL
  MEMORIAL_SERVICE
  GRAVESIDE_SERVICE
  CREMATION_SERVICE
  DIRECT_BURIAL
  GREEN_BURIAL
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole           @default(STAFF)
  phone             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bookingsDirected  Booking[]          @relation("DirectedBookings")
  hearseAssignments HearseAssignment[]
}

model CasketCatalog {
  id                String            @id @default(uuid())
  sku               String            @unique
  name              String
  description       String?
  material          CasketMaterial
  size              CasketSize        @default(STANDARD)
  finish            String?
  interiorType      String?
  wholesalePrice    Decimal           @db.Decimal(10, 2)
  retailPrice       Decimal           @db.Decimal(10, 2)
  minimumStockLevel Int               @default(2)
  reorderPoint      Int               @default(3)
  imageUrl          String?
  isActive          Boolean           @default(true)
  inventory         CasketInventory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CasketInventory {
  id              String          @id @default(uuid())
  catalogId       String
  catalog         CasketCatalog   @relation(fields: [catalogId], references: [id])
  serialNumber    String          @unique
  status          InventoryStatus @default(IN_STOCK)
  storageLocation String?
  purchaseDate    DateTime?
  purchasePrice   Decimal?        @db.Decimal(10, 2)
  bookingId       String?         @unique
  booking         Booking?        @relation(fields: [bookingId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Hearse {
  id                  String             @id @default(uuid())
  vehicleName         String
  make                String
  model               String
  year                Int
  licensePlate        String             @unique
  vin                 String?            @unique
  status              HearseStatus       @default(AVAILABLE)
  currentMileage      Int                @default(0)
  nextServiceMileage  Int?
  nextServiceDate     DateTime?
  insuranceExpiryDate DateTime?
  imageUrl            String?
  isActive            Boolean            @default(true)
  assignments         HearseAssignment[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model HearseAssignment {
  id                  String    @id @default(uuid())
  hearseId            String
  hearse              Hearse    @relation(fields: [hearseId], references: [id])
  bookingId           String?
  booking             Booking?  @relation(fields: [bookingId], references: [id])
  driverId            String?
  driver              User?     @relation(fields: [driverId], references: [id])
  scheduledDate       DateTime  @db.Date
  departureTime       String
  estimatedReturnTime String?
  pickupLocation      String
  destination         String
  status              String    @default("scheduled")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model FlowerCatalog {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("SAMPLE")
  unitPrice   Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FloralArrangement {
  id          String   @id @default(uuid())
  name        String
  description String?
  style       String?
  retailPrice Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoweringGear {
  id          String   @id @default(uuid())
  name        String
  description String?
  rentalPrice Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  quantity    Int      @default(1)
  status      String   @default("AVAILABLE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id            String     @id @default(uuid())
  firstName     String
  lastName      String
  email         String?
  phonePrimary  String
  addressLine1  String?
  city          String?
  state         String?
  zipCode       String?
  bookings      Booking[]
  deceased      Deceased[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Deceased {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  firstName     String
  lastName      String
  dateOfBirth   DateTime? @db.Date
  dateOfDeath   DateTime  @db.Date
  gender        String?
  heightInches  Int?
  weightPounds  Int?
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id                 String             @id @default(uuid())
  bookingNumber      String             @unique
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id])
  deceasedId         String?
  deceased           Deceased?          @relation(fields: [deceasedId], references: [id])
  serviceType        ServiceType
  serviceDate        DateTime?          @db.Date
  serviceStartTime   String?
  serviceEndTime     String?
  venueName          String?
  status             BookingStatus      @default(INQUIRY)
  assignedDirectorId String?
  assignedDirector   User?              @relation("DirectedBookings", fields: [assignedDirectorId], references: [id])
  casketInventory    CasketInventory?
  hearseAssignments  HearseAssignment[]
  totalAmount        Decimal            @default(0) @db.Decimal(10, 2)
  amountPaid         Decimal            @default(0) @db.Decimal(10, 2)
  paymentStatus      PaymentStatus      @default(PENDING)
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String
  paymentDate   DateTime @default(now())
  reference     String?
  createdAt     DateTime @default(now())
}